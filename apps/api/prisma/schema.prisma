// evdenevenakliyat.app veri modeli (MVP)
// Ayrıntılı açıklama: docs/veritabani.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Kullanıcılar ───────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(cuid())
  role            UserRole
  status          UserStatus @default(ACTIVE)
  fullName        String
  email           String?    @unique
  phone           String     @unique
  phoneVerifiedAt DateTime?
  passwordHash    String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  company       Company?
  requests      MovingRequest[]
  reviews       Review[]
  sentMessages  Message[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Nakliyat firmaları ─────────────────────────────────────────

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Company {
  id                 String             @id @default(cuid())
  ownerId            String             @unique
  legalName          String             @db.VarChar(200)
  displayName        String
  taxNumber          String             @unique
  k3LicenseNumber    String?
  description        String?            @db.Text
  logoUrl            String?            @db.VarChar(1000)
  cityCode           String             @db.Char(2)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verificationNote   String?            @db.VarChar(500)
  ratingAverage      Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount        Int                @default(0)
  completedJobs      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  owner         User                 @relation(fields: [ownerId], references: [id])
  serviceCities CompanyServiceCity[]
  documents     CompanyDocument[]
  vehicles      Vehicle[]
  quotes        Quote[]
  bookings      Booking[]
  reviews       Review[]

  @@index([verificationStatus])
  @@index([cityCode])
}

/// Firmanın hizmet verdiği iller (plaka kodu). "Bu ile kim hizmet veriyor?" sorgusu için ayrı tablo.
model CompanyServiceCity {
  companyId String
  cityCode  String @db.Char(2)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, cityCode])
  @@index([cityCode])
}

enum CompanyDocumentType {
  K3_LICENSE
  TAX_CERTIFICATE
  TRADE_REGISTRY
  INSURANCE
  OTHER
}

model CompanyDocument {
  id         String              @id @default(cuid())
  companyId  String
  type       CompanyDocumentType
  fileUrl    String              @db.VarChar(1000)
  status     VerificationStatus  @default(PENDING)
  reviewNote String?             @db.VarChar(500)
  createdAt  DateTime            @default(now())
  reviewedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum VehicleType {
  PANELVAN
  KAMYONET
  KAMYON
  TIR
}

model Vehicle {
  id            String      @id @default(cuid())
  companyId     String
  plate         String
  type          VehicleType
  capacityM3    Int
  hasLiftSystem Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, plate])
}

// ─── Taşıma talepleri ───────────────────────────────────────────

enum HomeType {
  STUDIO
  ONE_PLUS_ONE
  TWO_PLUS_ONE
  THREE_PLUS_ONE
  FOUR_PLUS_ONE
  VILLA
  OFFICE
}

enum RequestStatus {
  DRAFT
  OPEN
  BOOKED
  COMPLETED
  CANCELLED
  EXPIRED
}

model MovingRequest {
  id         String        @id @default(cuid())
  customerId String
  status     RequestStatus @default(OPEN)

  // İl plaka kodu ("34") ve ilçe adres kodu ("kadikoy"), bkz. @nakliyat/locations
  fromCityCode    String  @db.Char(2)
  fromDistrict    String
  fromAddress     String  @db.VarChar(300)
  fromFloor       Int
  fromHasElevator Boolean
  toCityCode      String  @db.Char(2)
  toDistrict      String
  toAddress       String  @db.VarChar(300)
  toFloor         Int
  toHasElevator   Boolean

  homeType       HomeType
  moveDate       DateTime
  isDateFlexible Boolean  @default(false)
  needsPacking   Boolean  @default(false)
  needsAssembly  Boolean  @default(false)
  needsStorage   Boolean  @default(false)
  /// Metin dizisi (JSON): ["Piyano", ...]
  specialItems   Json
  notes          String?  @db.Text

  // Sistem tarafından hesaplanan standart değerler
  estimatedVolumeM3 Int?
  estimatedCrew     Int?
  estimatedHours    Int?
  distanceKm        Int?

  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer User           @relation(fields: [customerId], references: [id])
  photos   RequestPhoto[]
  quotes   Quote[]
  booking  Booking?

  @@index([status, fromCityCode])
  @@index([status, toCityCode])
  @@index([customerId])
}

model RequestPhoto {
  id        String   @id @default(cuid())
  requestId String
  fileUrl   String   @db.VarChar(1000)
  caption   String?
  createdAt DateTime @default(now())

  request MovingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ─── Teklifler ──────────────────────────────────────────────────

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model Quote {
  id                String      @id @default(cuid())
  requestId         String
  companyId         String
  status            QuoteStatus @default(PENDING)
  priceTry          Decimal     @db.Decimal(10, 2)
  includesPacking   Boolean     @default(false)
  includesAssembly  Boolean     @default(false)
  includesInsurance Boolean     @default(false)
  crewSize          Int
  vehicleType       VehicleType
  message           String?     @db.Text
  validUntil        DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  request   MovingRequest   @relation(fields: [requestId], references: [id])
  company   Company         @relation(fields: [companyId], references: [id])
  booking   Booking?
  messages  Message[]
  revisions QuoteRevision[]

  // Bir firma bir talebe yalnızca bir teklif verebilir
  @@unique([requestId, companyId])
  @@index([companyId, status])
}

/// Teklif fiyatının her değişikliği saklanır (fiyat endeksi ve anlaşmazlık kaydı için).
model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  priceTry  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

// ─── Anlaşılan işler ────────────────────────────────────────────

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Booking {
  id           String        @id @default(cuid())
  requestId    String        @unique
  quoteId      String        @unique
  companyId    String
  status       BookingStatus @default(SCHEDULED)
  scheduledAt  DateTime
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  request  MovingRequest @relation(fields: [requestId], references: [id])
  quote    Quote         @relation(fields: [quoteId], references: [id])
  company  Company       @relation(fields: [companyId], references: [id])
  review   Review?
  messages Message[]

  @@index([companyId, status])
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  companyId    String
  customerId   String
  rating       Int // 1-5
  comment      String?  @db.Text
  companyReply String?  @db.Text
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  company  Company @relation(fields: [companyId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([companyId])
}

// ─── Mesajlaşma ve bildirimler ──────────────────────────────────

model Message {
  id        String    @id @default(cuid())
  quoteId   String?
  bookingId String?
  senderId  String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  quote   Quote?   @relation(fields: [quoteId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  sender  User     @relation(fields: [senderId], references: [id])

  @@index([quoteId, createdAt])
  @@index([bookingId, createdAt])
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  type      String
  title     String
  body      String              @db.Text
  data      Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ─── Yönetim ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}
