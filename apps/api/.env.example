# Uygulama
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# Veritabanı (MariaDB 10.6+ / MySQL 8; yerelde: docker compose up -d)
DATABASE_URL=mysql://nakliyat:nakliyat@localhost:3306/nakliyat

# Kimlik doğrulama
JWT_ACCESS_SECRET=degistir-beni


# E-posta bildirimleri (Brevo). Boşsa e-posta gönderilmez, bildirimler yalnızca uygulama içinde görünür.
# Ayrıntılar: docs/bildirimler.md
BREVO_API_KEY=
MAIL_FROM_EMAIL=bildirim@evdenevenakliyat.app
MAIL_FROM_NAME=evdenevenakliyat.app

# Hata takibi (isteğe bağlı). Sentry > Proje > Client Keys (DSN). Boşsa hatalar yalnızca loga yazılır.
SENTRY_DSN=

# Talep fotoğraf/videoları. Ayrıntılar: docs/dosya-yukleme.md
# R2 dört değeri birlikte girilirse dosyalar Cloudflare R2'de tutulur (önerilen). Boşsa sunucu diskine yazılır.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2'de toplam sınır (GB). Dolunca yeni yükleme durur, talep fotoğrafsız açılır. Varsayılan 9.5 (ücretsiz katman 10 GB)
# R2_QUOTA_GB=9.5
# Yalnızca disk kullanılırken: klasör (canlıda varsayılan ~/yuklemeler), toplam sınır (MB) ve API'nin dış adresi
# UPLOAD_DIR=
# LOCAL_UPLOAD_QUOTA_MB=400
# API_PUBLIC_URL=http://localhost:4000
