  "info": {
    "title": "evdenevenakliyat.app API",
    "description": "Evden eve taşınma pazaryeri REST API. Korunan uç noktalar için `Authorization: Bearer <accessToken>` başlığı gerekir.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "COMPANY"
            ],
            "example": "CUSTOMER"
          },
          "fullName": {
            "type": "string",
            "example": "Ayşe Yılmaz"
          },
          "phone": {
            "type": "string",
            "example": "0532 123 45 67",
            "description": "Türkiye cep telefonu"
          },
          "email": {
            "type": "string",
            "example": "ayse@ornek.com"
          },
          "password": {
            "type": "string",
            "example": "GucluSifre123",
            "minLength": 8
          }
        },
        "required": [
          "role",
          "fullName",
          "phone",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "COMPANY",
              "ADMIN"
            ]
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phoneVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "role",
          "fullName",
          "phone",
          "phoneVerified"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Kısa ömürlü erişim anahtarı (15 dk)"
          },
          "refreshToken": {
            "type": "string",
            "description": "Uzun ömürlü yenileme anahtarı (30 gün), tek kullanımlık"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "0532 123 45 67"
          },
          "password": {
            "type": "string",
            "example": "GucluSifre123"
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Kısa ömürlü erişim anahtarı (15 dk)"
          },
          "refreshToken": {
            "type": "string",
            "description": "Uzun ömürlü yenileme anahtarı (30 gün), tek kullanımlık"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "CreateRequestDto": {
        "type": "object",
        "properties": {
          "fromCityCode": {
            "type": "string",
            "example": "34",
            "description": "Çıkış ili plaka kodu"
          },
          "fromDistrict": {
            "type": "string",
            "example": "kadikoy",
            "description": "Çıkış ilçesi adres kodu (GET /locations/cities/:code/districts)"
          },
          "fromAddress": {
            "type": "string",
            "example": "Caferağa Mah. Moda Cad. No:1 D:5"
          },
          "fromFloor": {
            "type": "number",
            "example": 3,
            "description": "Kat (bodrum için -1)"
          },
          "fromHasElevator": {
            "type": "boolean"
          },
          "toCityCode": {
            "type": "string",
            "example": "06"
          },
          "toDistrict": {
            "type": "string",
            "example": "cankaya"
          },
          "toAddress": {
            "type": "string",
            "example": "Kızılay Mah. Atatürk Blv. No:10 D:2"
          },
          "toFloor": {
            "type": "number",
            "example": 2
          },
          "toHasElevator": {
            "type": "boolean"
          },
          "homeType": {
            "type": "string",
            "enum": [
              "STUDIO",
              "ONE_PLUS_ONE",
              "TWO_PLUS_ONE",
              "THREE_PLUS_ONE",
              "FOUR_PLUS_ONE",
              "VILLA",
              "OFFICE"
            ],
            "example": "TWO_PLUS_ONE"
          },
          "moveDate": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-15",
            "description": "Taşınma tarihi (en erken yarın, en geç 1 yıl sonra)"
          },
          "isDateFlexible": {
            "type": "boolean",
            "default": false
          },
          "needsPacking": {
            "type": "boolean",
            "default": false
          },
          "needsAssembly": {
            "type": "boolean",
            "default": false
          },
          "needsStorage": {
            "type": "boolean",
            "default": false
          },
          "specialItems": {
            "example": [
              "Piyano",
              "Antika vitrin"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string",
            "example": "Sokak dar, kamyon girmiyor."
          }
        },
        "required": [
          "fromCityCode",
          "fromDistrict",
          "fromAddress",
          "fromFloor",
          "fromHasElevator",
          "toCityCode",
          "toDistrict",
          "toAddress",
          "toFloor",
          "toHasElevator",
          "homeType",
          "moveDate"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "UpdateRequestDto": {
        "type": "object",
        "properties": {
          "fromCityCode": {
            "type": "string",
            "example": "34",
            "description": "Çıkış ili plaka kodu"
          },
          "fromDistrict": {
            "type": "string",
            "example": "kadikoy",
            "description": "Çıkış ilçesi adres kodu (GET /locations/cities/:code/districts)"
          },
          "fromAddress": {
            "type": "string",
            "example": "Caferağa Mah. Moda Cad. No:1 D:5"
          },
          "fromFloor": {
            "type": "number",
            "example": 3,
            "description": "Kat (bodrum için -1)"
          },
          "fromHasElevator": {
            "type": "boolean"
          },
          "toCityCode": {
            "type": "string",
            "example": "06"
          },
          "toDistrict": {
            "type": "string",
            "example": "cankaya"
          },
          "toAddress": {
            "type": "string",
            "example": "Kızılay Mah. Atatürk Blv. No:10 D:2"
          },
          "toFloor": {
            "type": "number",
            "example": 2
          },
          "toHasElevator": {
            "type": "boolean"
          },
          "homeType": {
            "type": "string",
            "enum": [
              "STUDIO",
              "ONE_PLUS_ONE",
              "TWO_PLUS_ONE",
              "THREE_PLUS_ONE",
              "FOUR_PLUS_ONE",
              "VILLA",
              "OFFICE"
            ],
            "example": "TWO_PLUS_ONE"
          },
          "moveDate": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-15",
            "description": "Taşınma tarihi (en erken yarın, en geç 1 yıl sonra)"
          },
          "isDateFlexible": {
            "type": "boolean",
            "default": false
          },
          "needsPacking": {
            "type": "boolean",
            "default": false
          },
          "needsAssembly": {
            "type": "boolean",
            "default": false
          },
          "needsStorage": {
            "type": "boolean",
            "default": false
          },
          "specialItems": {
            "example": [
              "Piyano",
              "Antika vitrin"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string",
            "example": "Sokak dar, kamyon girmiyor."
          }
        }
      }
    }
  }
}
