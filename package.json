{
  "name": "nakliyat-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @nakliyat/api db:generate",
    "db:migrate": "pnpm --filter @nakliyat/api db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  }
}
